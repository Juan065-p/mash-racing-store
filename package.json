{
  "name": "mash-racing-store",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-server && node scripts/prerender.mjs",
    "preview": "node scripts/serve-dist.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:catalog": "node scripts/validate-catalog.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
